<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="GlobalUsingAnalyzer.1eb6648b-e2bf-424b-ac28-3291e8d70717" Version="1.0.0" Language="en-US" Publisher="Luke Vo" />
    <DisplayName>GlobalUsingAnalyzer</DisplayName>
    <Description xml:space="preserve">Promotes C# usings to &lt;Using /&gt; or global usings in a single file. Promotes `@using` in Razor Components (both .razor and .cshtml) to relevant files like `_Imports.razor`.</Description>
    <MoreInfo>https://github.com/datvm/GlobalUsingAnalyzer</MoreInfo>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.7.2,)" d:Source="Manual" />
  </Dependencies>
  <Assets>
    <!-- Razor editor lightbulb (ISuggestedActionsSourceProvider). -->
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="|GlobalUsingAnalyzer|" d:Source="Project" d:ProjectName="GlobalUsingAnalyzer" />
    <Asset Type="Microsoft.VisualStudio.Analyzer" Path="|GlobalUsingAnalyzer|" d:Source="Project" d:ProjectName="GlobalUsingAnalyzer" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="|GlobalUsingAnalyzer.CodeFixes|" d:Source="Project" d:ProjectName="GlobalUsingAnalyzer.CodeFixes" />
    <Asset Type="Microsoft.VisualStudio.Analyzer" Path="|GlobalUsingAnalyzer.CodeFixes|" d:Source="Project" d:ProjectName="GlobalUsingAnalyzer.CodeFixes" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="|GlobalUsingAnalyzer.Vsix|" d:Source="Project" d:ProjectName="GlobalUsingAnalyzer.Vsix" />
  </Assets>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" DisplayName="Visual Studio core editor" Version="[15.0,)" />
    <Prerequisite Id="Microsoft.VisualStudio.Component.Roslyn.LanguageServices" DisplayName="Roslyn Language Services" Version="[15.0,)" />
  </Prerequisites>
</PackageManifest>