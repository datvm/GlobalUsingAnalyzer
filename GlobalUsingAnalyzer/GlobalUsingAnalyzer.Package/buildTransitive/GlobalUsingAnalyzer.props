<Project>
  <!--
    Feed Razor sources to the compiler as AdditionalFiles so GUA003 can see @using directives.
    - .cshtml  → nearest _ViewImports.cshtml (MVC / Razor Pages)
    - .razor   → nearest _Imports.razor (Blazor)

    Also expose the project directory so VSIX/IDE analyzers can fall back to disk discovery
    when AdditionalFiles are not present.

    Opt out of AdditionalFiles with:
      <GlobalUsingAnalyzerIncludeRazorFiles>false</GlobalUsingAnalyzerIncludeRazorFiles>
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    <CompilerVisibleProperty Include="MSBuildProjectFullPath" />
    <CompilerVisibleProperty Include="ProjectDir" />
  </ItemGroup>

  <ItemGroup Condition="'$(GlobalUsingAnalyzerIncludeRazorFiles)' != 'false'">
    <AdditionalFiles Include="**/*.cshtml" />
    <AdditionalFiles Include="**/*.razor" />
  </ItemGroup>
</Project>

